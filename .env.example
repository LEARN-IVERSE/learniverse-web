# Copy to .env.local (never commit it)
API_URL=http://localhost:8000
# Production on Vercel: match LOGIN_PROXY_SECRET on the API, never expose to the browser.
LOGIN_PROXY_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Google OAuth client ID ("Web application"); public by design, never the client secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
